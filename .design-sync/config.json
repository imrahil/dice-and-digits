{
  "projectId": "eaa75923-198f-4ee7-ba2c-0bcb531df3d1",
  "shape": "package",
  "pkg": "dice-and-digits-ui",
  "globalName": "DiceAndDigitsUi",
  "buildCmd": "npm --prefix .design-sync/lib run build",
  "entry": ".design-sync/lib/dist/index.js",
  "srcDir": "../../src/components",
  "cssEntry": "dist/style.css",
  "readmeHeader": ".design-sync/conventions.md",
  "provider": { "component": "I18nProvider", "props": { "lang": "en" } },
  "overrides": {
    "SessionRow": { "cardMode": "column" },
    "CounterBoard": { "cardMode": "column" },
    "Logo": { "cardMode": "column" },
    "Page": { "cardMode": "column" },
    "Section": { "cardMode": "column" },
    "RoundsTable": { "cardMode": "column" },
    "SheetBoard": { "cardMode": "column" },
    "SheetTable": { "cardMode": "column" },
    "WinnerBoard": { "cardMode": "column" },
    "Sheet": { "cardMode": "single", "primaryStory": "GameMenu", "viewport": "480x600" },
    "BottomBar": { "cardMode": "single", "primaryStory": "TwoActions", "viewport": "480x340" },
    "DialogHost": { "cardMode": "single", "primaryStory": "Confirm", "viewport": "480x440" },
    "QrShareSheet": { "cardMode": "single", "primaryStory": "LiveGame", "viewport": "480x760" },
    "RoundsBoard": { "cardMode": "single", "primaryStory": "EnteringRound", "viewport": "480x900" }
  },
  "componentSrcMap": {
    "I18nProvider": null,
    "Icons": null,
    "Page": "../../src/components/ui.tsx",
    "Button": "../../src/components/ui.tsx",
    "IconButton": "../../src/components/ui.tsx",
    "Card": "../../src/components/ui.tsx",
    "Section": "../../src/components/ui.tsx",
    "Avatar": "../../src/components/ui.tsx",
    "Sheet": "../../src/components/ui.tsx",
    "Toggle": "../../src/components/ui.tsx",
    "Segmented": "../../src/components/ui.tsx",
    "Empty": "../../src/components/ui.tsx",
    "BottomBar": "../../src/components/ui.tsx",
    "KeypadDisplay": "../../src/components/Keypad.tsx",
    "QrCode": "../../src/components/QrShare.tsx",
    "QrShareSheet": "../../src/components/QrShare.tsx",
    "DialogHost": "../../src/components/dialogs.tsx",
    "RoundsTable": "../../src/components/play/RoundsBoard.tsx",
    "SheetTable": "../../src/components/play/SheetBoard.tsx"
  }
}
