# Cloudflare Worker base URL (no trailing slash, no /api). Baked in at build
# time, so changing it needs a rebuild + redeploy. Fill in after
# `npx wrangler deploy` in worker/, e.g.:
#   VITE_API_URL=https://dice-and-digits-api.<subdomain>.workers.dev
# Leave empty to ship a local-only build: scoring, history, stats and tools all
# work; shared groups and live scoreboards are hidden.
VITE_API_URL=https://dice-and-digits-api.imrahil.workers.dev
